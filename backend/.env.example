# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=store

# JWT Configuration
JWT_ACCESS_SECRET=your-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed frontend origins
# Examples:
# Development: http://localhost:4200,http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# VigilEye Configuration
VIGILEYE_API_KEY=your-api-key
VIGILEYE_SERVER_URL=http://your-vigileye-server.com
VIGILEYE_ENABLED=false
